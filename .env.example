# ==============================================================================
# CIVICLENS (GVMC VISAKHAPATNAM) - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL + POSTGIS & STORAGE
# Obtain from https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 2. GEMINI 2.5 FLASH MULTIMODAL API (Vision & Dual-Image QC Engine)
# Obtain from https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS PLATFORM (Reverse Geocoding & Routes API v2)
# Enable: Geocoding API & Routes API on Google Cloud Console
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 3. GOOGLE FIREBASE (Firestore Realtime Sync & Cloud Storage)
# Obtain from Firebase Console -> Project Settings -> General -> Web App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=civiclens-vizag.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=civiclens-vizag
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=civiclens-vizag.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 4. RUNTIME GRACEFUL DEGRADATION FLAGS
# If any key is left unset, CivicLens automatically falls back to:
# - Seeded Visakhapatnam landmark centroids for Reverse Geocoding
# - Local Traveling Salesperson Nearest-Neighbor for Routes Optimization
# - Local structural heuristics for Dual-Image Quality Verification
# - In-Memory Local Mesh Broadcaster for Real-Time Triage Synchronization
# ------------------------------------------------------------------------------
